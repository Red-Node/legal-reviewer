{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "PUBLIC_DEMO_ONLY=true exec python -m uvicorn main:app --host 0.0.0.0 --port $PORT --no-access-log",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60
  }
}
